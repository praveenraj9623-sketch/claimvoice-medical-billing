TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
CLAIMVOICE_TEST_NUMBER=
CLAIMVOICE_PUBLIC_URL=
CLAIMVOICE_MAX_CALL_SECONDS=120
# Enter your actual combined rate and budget before using the optional test dialer.
CLAIMVOICE_ESTIMATED_USD_PER_MIN=
CLAIMVOICE_MAX_ESTIMATED_USD=
# Local file or direct/transaction-pooler PostgreSQL connection string.
CLAIMVOICE_PHONE_STORAGE=claimvoice-phone.sqlite3
# Optional and used only by review-ai.
GROQ_API_KEY=
# Safe default. Enable only in the private operator environment after preflight.
CLAIMVOICE_DIALING_ENABLED=false
CLAIMVOICE_DAILY_ESTIMATED_USD=
# Docker defaults to hosted, which requires PostgreSQL with sslmode=verify-full.
CLAIMVOICE_ENV=local
