FROM ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends asterisk ffmpeg && rm -rf /var/lib/apt/lists/*
COPY render_menu.sh /tmp/render_menu.sh
RUN mkdir -p /var/lib/asterisk/sounds/claimcall && sh /tmp/render_menu.sh 2 /var/lib/asterisk/sounds/claimcall/menu.ulaw && sh /tmp/render_menu.sh 3 /var/lib/asterisk/sounds/claimcall/menu-changed.ulaw
RUN ffmpeg -v error -f lavfi -i "flite=text='This is Daniel. The claim is still pending. There is no payment information yet.':voice=slt" -ar 8000 -ac 1 -f mulaw /var/lib/asterisk/sounds/claimcall/pending.ulaw
RUN ffmpeg -v error -f lavfi -i "flite=text='This is Maria. The claim was paid. We paid eight hundred and fifty dollars on March twentieth, twenty twenty six. The payment reference is eight eight four one.':voice=slt" -ar 8000 -ac 1 -f mulaw /var/lib/asterisk/sounds/claimcall/paid.ulaw
RUN ffmpeg -v error -f lavfi -i "flite=text='First digit is eight. Second digit is eight. Third digit is four. Fourth digit is one.':voice=slt" -ar 8000 -ac 1 -f mulaw /var/lib/asterisk/sounds/claimcall/digits.ulaw
RUN ffmpeg -v error -f lavfi -i "flite=text='Position one is eight. Position two is eight. Position three is four. Position four is one.':voice=slt" -ar 8000 -ac 1 -f mulaw /var/lib/asterisk/sounds/claimcall/positions.ulaw
CMD ["asterisk", "-f", "-U", "asterisk", "-G", "asterisk", "-vv"]
